# Production template: copy to .env on the server and fill in the blanks.
# Never commit the real .env.

APP_NAME=SecOpsForge
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://example.com   # your domain, https

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite

# Admin account (AdminSeeder). Leave ADMIN_PASSWORD empty to get a random
# one printed once, then remove these lines after seeding.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sessions are stored client-side in an encrypted cookie.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=example.com    # your domain, no scheme
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Comma-separated proxy IPs, or * if the app is only reachable through the proxy.
TRUSTED_PROXIES=

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Docker (see DEPLOY.md)
# Domain for automatic HTTPS, or ":80" behind another reverse proxy.
SERVER_NAME=example.com
# Host folder where the articles repository is cloned (mounted in the container).
CONTENT_PATH=/opt/secopsforge-content
# Host ports; e.g. 127.0.0.1:8081 behind another reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
